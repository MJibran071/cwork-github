# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/cwork_marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cwork_marketplace

# Application Configuration
PORT=3002
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT Configuration (for auth service integration)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Blockchain Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-infura-project-id
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PRIVATE_KEY=your-private-key-here
CHAIN_ID=1
CONTRACT_ADDRESS=0xYourContractAddressHere

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Logging
LOG_LEVEL=info